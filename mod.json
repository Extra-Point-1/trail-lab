			"type": "TitleSetting",
			"name": "General Settings",
			"description": "Global settings for Trail Lab"
		},
		{
			"type": "BoolSetting",
			"name": "Enable Mod",
			"key": "mod-enabled",
			"description": "Enable or disable Trail Lab entirely",
			"default": true
		},
		{
			"type": "BoolSetting",
			"name": "Live Preview",
			"key": "live-preview",
			"description": "Show live preview of trail changes in menu",
			"default": false,
			"platforms": {
				"android": true
			}
		},
		{
			"type": "ButtonSetting",
			"name": "Restore Defaults",
