{
	"id": "trail-lab",
	"name": "Trail Lab",
	"version": "1.0.0",
	"geode": "5.11.2",
	"gd": "2.208",
	"developer": "TrailLabTeam",
	"description": "Advanced trail customization tool for Geometry Dash. Customize trail length, width, opacity, glow, and color per game mode with presets and live preview.",
	"summary": "Customize Geometry Dash trails per game mode",
	"platforms": {
		"android": true
	},
	"settings": [
